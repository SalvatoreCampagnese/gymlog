# Supabase: in locale li stampa `npx supabase start` (o `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Indirizzo pubblico del sito, usato nei link delle email e nel comando Apple Salute
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# OpenAI per la stima AI degli alimenti
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Notifiche di fine recupero (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
